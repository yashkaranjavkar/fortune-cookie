# Copy this file to .env and adjust. Every setting is optional.

# Port the API listens on
PORT=4318

# Where the SQLite database file is kept
DB_PATH=./data/analytics.sqlite

# Password for reading/deleting data (the Analytics page and exports).
# Leave empty only for local testing - anyone could read player data otherwise.
ADMIN_TOKEN=

# Which websites may call the API from a browser (comma separated, * = any).
# In production, set this to the address the game is hosted at, e.g.
# CORS_ORIGINS=https://fortunery.example.com
CORS_ORIGINS=*

# Limits on what one request may send
MAX_BODY_BYTES=1048576
MAX_EVENTS_PER_BATCH=500
